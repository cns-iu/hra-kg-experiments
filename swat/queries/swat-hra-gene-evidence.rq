PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ccf: <http://purl.org/ccf/>
PREFIX HRA: <https://purl.humanatlas.io/collection/hra>

SELECT ?asctb_table ?record_number 
  (SAMPLE(?as_label) as ?as_label)
  (SAMPLE(?as) as ?as)
  (SAMPLE(?ct_label) as ?cell_label)
  (SAMPLE(?cell_id) as ?cell_id)
  (SAMPLE(?matched_genes) as ?matched_genes)
  (SAMPLE(?matched_gene_count) as ?matched_gene_count)
  (GROUP_CONCAT(DISTINCT ?gene_label;SEPARATOR='; ') as ?gene_symbols)
  (GROUP_CONCAT(DISTINCT ?hgnc_id;SEPARATOR='; ') as ?hgnc_ids)
  (GROUP_CONCAT(DISTINCT ?reference;SEPARATOR='; ') as ?references)
